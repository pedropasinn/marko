# URL pública da API, sem barra final. Vazia usa o mesmo domínio com /api/v1.
VITE_API_BASE_URL=

# Dados demonstrativos só são habilitados explicitamente.
VITE_DATA_MODE=http

# O deploy público sintético permanece public. Private exige Neon Auth e verificação JWT na API.
VITE_AUTH_MODE=public
VITE_NEON_AUTH_URL=
